{
  "multipart": [
    {
      "apply": {
        "model": "miencrap3minerat:block/connected_xp_glass"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass"
      },
      "when": {
        "north": "false"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass",
        "y":-90
      },
      "when": {
        "west": "false"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass",
        "y":90
      },
      "when": {
        "east": "false"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass",
        "y":180
      },
      "when": {
        "south": "false"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass",
        "x":90
      },
      "when": {
        "down": "false"
      }
    },
    {
      "apply": {
        "model": "miencrap3minerat:block/decoration/xp_glass",
        "x":-90
      },
      "when": {
        "up": "false"
      }
    }
  ]
}
